KUBERNETES_NAMESPACE=opspilot
KUBERNETES_DEPLOYMENT=ticket-booking

KUBEMEDIC_BOB_MODE=kubemedic-analyst
KUBEMEDIC_BOB_TIMEOUT_SECONDS=180
KUBEMEDIC_BOB_BINARY=bobide
KUBEMEDIC_WORKSPACE=.

# IBM Bob cloud REST API — required for headless invocation.
# IBM Bob v1.126.0 (bobide/Antigravity IDE) is a GUI application with no
# headless subprocess mode. The REST path is the only programmatic interface.
# Get these values from the IBM Bob cloud console (https://cloud.manufact.com).
KUBEMEDIC_BOB_API_KEY=your-api-key-here
KUBEMEDIC_BOB_API_BASE=https://cloud.manufact.com
KUBEMEDIC_BOB_AGENT_ID=your-agent-id-here
