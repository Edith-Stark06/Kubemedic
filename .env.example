# ── Kubernetes ────────────────────────────────────────────────────────────
KUBERNETES_NAMESPACE=opspilot
KUBERNETES_DEPLOYMENT=ticket-booking
KUBEMEDIC_NAMESPACE=opspilot
KUBEMEDIC_DEPLOYMENT=ticket-booking
KUBEMEDIC_SERVICE=ticket-booking

# ── Reasoning provider ────────────────────────────────────────────────────
# One switch selects the engine. Everything downstream is unchanged: every
# provider returns the same validated BobAnalysis contract.
#   ibm-bob   IBM Bob cloud REST         (default)
#   watsonx   IBM watsonx.ai
#   anthropic Anthropic Claude           (development / fallback)
#   manual    an analysis produced in an interactive IBM Bob session
#   auto      first configured engine wins, ending at the host IDE (default)
#   host      the agentic IDE hosting this workspace, via a file hand-off
KUBEMEDIC_REASONING_PROVIDER=auto

# Where credentials are read from: env | file | k8s | vault
#   file  one file per secret under KUBEMEDIC_SECRETS_DIR (/run/secrets)
#   k8s   a Secret named KUBEMEDIC_SECRETS_NAME in KUBEMEDIC_NAMESPACE
KUBEMEDIC_SECRETS_BACKEND=env

# ── provider: ibm-bob ─────────────────────────────────────────────────────
# Bob 2.0's headless CLI, Bob Shell (`bob run`), authenticated with an
# Inference-scoped API key. Install: https://bob.ibm.com/docs/shell
# Create the key in the Bob web portal (Scope: Inference). Bob usage is
# metered, so every call is capped.
#
# The key is handed to the child process through its environment only -- never
# on a command line, in a log, or in an audit record. Keep it in .env (which is
# git-ignored) or a mounted Secret; never commit it.
KUBEMEDIC_BOB_API_KEY=
# A General-scope key also needs a team id. Inference-scoped keys do not.
# KUBEMEDIC_BOB_TEAM_ID=
# Cost ceiling per analysis, in Bob's own cost units, and a turn ceiling.
KUBEMEDIC_BOB_MAX_COST=2.0
KUBEMEDIC_BOB_MAX_TURNS=3
KUBEMEDIC_BOB_TIMEOUT_SECONDS=180
# Bob Shell's location, if it is not on PATH.
# KUBEMEDIC_BOB_BIN=
# The custom mode used, defined in agent/providers/bob_workspace/.bob/.
KUBEMEDIC_BOB_MODE=kubemedic-reasoner

# ── provider: watsonx ─────────────────────────────────────────────────────
# IAM API key from IBM Cloud, plus a watsonx.ai project with the runtime
# service. The key is exchanged for a ~1h bearer token, cached in-process.
KUBEMEDIC_WATSONX_API_KEY=
KUBEMEDIC_WATSONX_PROJECT_ID=
KUBEMEDIC_WATSONX_URL=https://us-south.ml.cloud.ibm.com
KUBEMEDIC_WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
KUBEMEDIC_WATSONX_TIMEOUT_SECONDS=180

# ── provider: anthropic ───────────────────────────────────────────────────
# An API key from console.anthropic.com. A Claude.ai or Claude Code login is
# NOT this -- different product, separate billing, no API access.
KUBEMEDIC_ANTHROPIC_API_KEY=
KUBEMEDIC_ANTHROPIC_MODEL=claude-sonnet-5

# ── provider: host ────────────────────────────────────────────────────────
# Reason using whatever agentic IDE is hosting this workspace -- Claude Code,
# the IBM Bob IDE, or Antigravity. Needs NO credentials.
#
# None of those hosts exposes an API a child process can call, so the channel
# is the workspace filesystem: the pipeline writes .kubemedic/
# reasoning-request.md, the host agent answers into
# .kubemedic/reasoning-response.json, and the answer is validated exactly as a
# headless one. The audit record names which host answered.
#
# 0 = write the request and return immediately (run the command again after
# answering). Raise it to wait in-process instead.
KUBEMEDIC_HOST_WAIT_SECONDS=0
# Force the detected host, e.g. when the markers are ambiguous.
# KUBEMEDIC_HOST_KIND=ibm-bob

# ── provider: manual ──────────────────────────────────────────────────────
# Point at the JSON an interactive IBM Bob session returned. Needs no
# credentials at all -- Bob does the reasoning in the workspace, calling the
# read-only MCP evidence server itself.
KUBEMEDIC_MANUAL_ANALYSIS_FILE=bob-analysis.json

# ── Dashboard ─────────────────────────────────────────────────────────────
# Set this and the dashboard talks to the real agent. Without it, it serves
# fixture data for local UI development.
KUBEMEDIC_AGENT_BASE_URL=http://127.0.0.1:8100
KUBEMEDIC_API_HOST=127.0.0.1
KUBEMEDIC_API_PORT=8100

# ── Fallback ──────────────────────────────────────────────────────────────
# OFF unless you turn it on. A fallback sends the incident's evidence (pod
# states, event messages, ticket text) to a DIFFERENT vendor than the one you
# configured. That is a data-governance decision, not a default.
AI_FALLBACK_ENABLED=false
# AI_FALLBACK_PROVIDER=gemini

# ── Security ──────────────────────────────────────────────────────────────
# Production: require a token on every route except liveness. With no tokens
# configured the API refuses everything (it fails closed) and will not start.
#   KUBEMEDIC_API_TOKENS  identity:role:token, comma separated
#   roles                 viewer | approver | admin
# The approver recorded in the audit trail is the token's identity; the
# `approver` field in a request body is ignored when auth is required.
# Generate a token: python -c "import secrets; print(secrets.token_urlsafe(32))"
KUBEMEDIC_REQUIRE_AUTH=false
# KUBEMEDIC_API_TOKENS=alice:approver:<token>,bob:viewer:<token>
# Namespaces an incident may be opened against (default: KUBEMEDIC_NAMESPACE).
# KUBEMEDIC_ALLOWED_NAMESPACES=opspilot
# Demo fault injection and the engine switch. On in development, off when auth
# is required, unless set explicitly.
# KUBEMEDIC_ENABLE_PRESENTER_TOOLS=false

# ── State ─────────────────────────────────────────────────────────────────
# Incidents and the hash-chained audit trail. Survives a restart.
KUBEMEDIC_STATE_DB=data/kubemedic-state.db
# The ticket store the watcher writes to.
# KUBEMEDIC_TICKET_DB=data/kubemedic.db
# The MCP evidence server is read-only on the `evidence` profile, so its ticket
# watcher is off there unless you enable it.
# KUBEMEDIC_MCP_WATCHER=false
# Where the application answers its health check through the Service proxy.
# KUBEMEDIC_HEALTH_PATH=health
# KUBEMEDIC_HEALTH_PORT=http
